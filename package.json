    "@tanstack/query-core": "^5.102.7",
    "@tanstack/query-db-collection": "1.2.2",
    "@tanstack/react-db": "^0.1.96",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "agents": "^0.22.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "match-sorter": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tasty-agent": "^7.1.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "yahoo-finance2": "4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@oxlint/plugins": "1.78.0",
