{
  "name": "spice",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" --max-warnings=0 && oxlint",
    "build": "cf build && tsc --noEmit && node tools/apply-migrations.mjs",
    "workers-builds:build": "npm ci && npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && cf d1 migrations apply e45e35cc-bd01-4e29-8940-b5d2ef5e840c --dir migrations && cf deploy --prebuilt",
    "deploy:preview": "npm run build && cf workers versions create --prebuilt",
    "cf-typegen": "cf workers types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "catalog:refresh": "bash ops/instrument-catalog/run.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/mcp": "^1.7.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
